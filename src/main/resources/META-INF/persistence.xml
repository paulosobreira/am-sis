<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="am-sis-jpa" transaction-type="RESOURCE_LOCAL">
        <class>br.com.am.entidades.Arquivamento</class>
        <class>br.com.am.entidades.Binario</class>
        <class>br.com.am.entidades.Empresa</class>
        <class>br.com.am.entidades.TipoArquivamento</class>
        <class>br.com.am.entidades.TipoExpurgo</class>
        <class>br.com.am.entidades.Usuario</class>
        <properties>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:file:./data/am-sis;AUTO_SERVER=TRUE"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>
